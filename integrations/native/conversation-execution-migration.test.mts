let initialized=false;
const blocked:string[]=[];
vi.spyOn(net.Socket.prototype,'connect').mockImplementation((()=>{blocked.push('tcp');throw Error('CONVERSATION_NETWORK_FORBIDDEN');}) as any);
vi.spyOn(net.Server.prototype,'listen').mockImplementation((()=>{blocked.push('listen');throw Error('CONVERSATION_LISTEN_FORBIDDEN');}) as any);
for(const name of Object.keys(dns).filter(name=>name.startsWith('resolve')||name==='reverse'||name==='lookupService'||name==='lookup'))vi.spyOn(dns,name as any).mockImplementation((()=>{blocked.push('dns');throw Error('CONVERSATION_DNS_FORBIDDEN');}) as any);
for(const name of Object.keys(dns.promises).filter(name=>name.startsWith('resolve')||name==='reverse'||name==='lookupService'||name==='lookup'))vi.spyOn(dns.promises,name as any).mockImplementation((()=>{blocked.push('dns');throw Error('CONVERSATION_DNS_FORBIDDEN');}) as any);
for(const name of ['send','connect','bind'] as const)vi.spyOn(dgram.Socket.prototype,name as any).mockImplementation((()=>{blocked.push('udp');throw Error('CONVERSATION_UDP_FORBIDDEN');}) as any);
for(const name of ['exec','execFile','execSync','execFileSync','spawn','spawnSync','fork'] as const)vi.spyOn(childProcess,name as any).mockImplementation((()=>{blocked.push('child');throw Error('CONVERSATION_CHILD_FORBIDDEN');}) as any);
syncBuiltinESMExports();
afterAll(()=>{if(initialized)db.closeDatabase();vi.restoreAllMocks();syncBuiltinESMExports();});

it('fixture actually rejects socket, listener, DNS, UDP and child execution',()=>{
 for(const target of [{host:'192.0.2.1',port:443},{host:'::1',port:443},{path:'/synthetic-denied.sock'},{path:'\\\\.\\pipe\\synthetic-denied'}])expect(()=>new net.Socket().connect(target as any)).toThrow('CONVERSATION_NETWORK_FORBIDDEN');
 expect(()=>new net.Socket().connect(443,'192.0.2.1')).toThrow('CONVERSATION_NETWORK_FORBIDDEN');
 for(const target of [{host:'127.0.0.1',port:0},{host:'::1',port:0},'/synthetic-denied.sock','\\\\.\\pipe\\synthetic-denied'])expect(()=>net.createServer().listen(target as any)).toThrow('CONVERSATION_LISTEN_FORBIDDEN');
 expect(()=>net.createServer().listen(0,'127.0.0.1')).toThrow('CONVERSATION_LISTEN_FORBIDDEN');
 expect(()=>dns.resolve('synthetic.invalid',()=>{})).toThrow('CONVERSATION_DNS_FORBIDDEN');
 expect(()=>dns.promises.resolve('synthetic.invalid')).toThrow('CONVERSATION_DNS_FORBIDDEN');
 const udp=dgram.createSocket('udp4');expect(()=>udp.send('x',1234,'192.0.2.1')).toThrow('CONVERSATION_UDP_FORBIDDEN');
 expect(()=>udp.connect(1234,'192.0.2.1')).toThrow('CONVERSATION_UDP_FORBIDDEN');
 expect(()=>udp.bind(1234,'127.0.0.1')).toThrow('CONVERSATION_UDP_FORBIDDEN');udp.close();
 expect(()=>childProcess.spawn('synthetic')).toThrow('CONVERSATION_CHILD_FORBIDDEN');
 expect(()=>childProcess.spawnSync('synthetic')).toThrow('CONVERSATION_CHILD_FORBIDDEN');
 blocked.length=0;
});


it('migrates actual D2 accepted receipt/message into recoverable queued execution under current authority',async()=>{
 const first=JSON.parse(fs.readFileSync(path.join(DATA_DIR,'conversation-first.json'),'utf8'));
 expect(first.processId).not.toBe(process.pid);
 const file=path.join(STORE_DIR,'messages.db'),before=new Database(file);
 const oldReceipt=before.prepare('SELECT * FROM wecom_conversation_receipts WHERE receipt_id=?').get(first.sdkReceipt.receiptId);
 const oldMessage=before.prepare('SELECT * FROM messages WHERE id=?').get(first.sdkReceipt.messageId);
 expect(oldReceipt).toBeDefined();expect(oldMessage).toBeDefined();
 expect(before.prepare("SELECT value FROM router_state WHERE key='schema_version'").get()).toEqual({value:'70'});before.close();
 const blocker=path.join(DATA_DIR,'migration-backup-blocker');fs.writeFileSync(blocker,'synthetic');process.env.MINICLAW_MIGRATION_BACKUP_DIR=blocker;
 expect(()=>db.initDatabase()).toThrow('pre-migration backup failed');
 const unchanged=new Database(file);
 expect(unchanged.prepare('SELECT * FROM wecom_conversation_receipts WHERE receipt_id=?').get(first.sdkReceipt.receiptId)).toEqual(oldReceipt);
 expect(unchanged.prepare('SELECT * FROM messages WHERE id=?').get(first.sdkReceipt.messageId)).toEqual(oldMessage);
 expect(unchanged.prepare("SELECT value FROM router_state WHERE key='schema_version'").get()).toEqual({value:'70'});
 expect(unchanged.prepare("SELECT name FROM sqlite_master WHERE name='wecom_conversation_execution'").get()).toBeUndefined();unchanged.close();delete process.env.MINICLAW_MIGRATION_BACKUP_DIR;
 db.initDatabase();initialized=true;
 expect(db.readConversationResults(first.sdkReceipt.receiptId)).toEqual([]);
 expect(db.readBotConversationReceipt(first.sdkReceipt.receiptId)).toMatchObject(first.sdkReceipt);
 expect(db.readConversationExecution(first.sdkReceipt.receiptId)).toEqual({state:'queued'});
 let permitted=false;db.bindConversationAuthority(()=>permitted);
 expect(db.listQueuedConversationReceipts()).toEqual([]);
 expect(db.getMessagesSince(first.sdkReceipt.workspaceJid,{timestamp:'',id:''})).toEqual([]);
 permitted=true;
 expect(db.listQueuedConversationReceipts()).toContain(first.sdkReceipt.receiptId);
 expect(db.getMessagesSince(first.sdkReceipt.workspaceJid,{timestamp:'',id:''}).filter(row=>row.id===first.sdkReceipt.messageId)).toHaveLength(1);
 const after=new Database(file);
 expect(after.prepare('SELECT * FROM wecom_conversation_receipts WHERE receipt_id=?').get(first.sdkReceipt.receiptId)).toEqual(oldReceipt);
 expect(after.prepare('SELECT * FROM messages WHERE id=?').get(first.sdkReceipt.messageId)).toEqual(oldMessage);after.close();
 expect(fs.readdirSync(path.join(STORE_DIR,'migration-backups')).some(name=>name.startsWith('messages-v70-to-v72-'))).toBe(true);
 fs.writeFileSync(process.env.QIWE_CONVERSATION_EVIDENCE!,JSON.stringify({phase:'migration',processId:process.pid,priorProcessId:first.processId,receiptId:first.sdkReceipt.receiptId,state:'queued',unauthorizedDispatch:0,authorizedPending:1,originalInputPreserved:true}));
});
